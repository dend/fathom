// Windows resources for fathom.exe and fth.exe. build.rs fills in the
// @...@ placeholders for each.

1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @VERSION_NUMBERS@
PRODUCTVERSION @VERSION_NUMBERS@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Den"
      VALUE "FileDescription", "@DESCRIPTION@"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "@NAME@"
      VALUE "LegalCopyright", "Copyright (c) Den"
      VALUE "OriginalFilename", "@NAME@.exe"
      VALUE "ProductName", "Fathom"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
